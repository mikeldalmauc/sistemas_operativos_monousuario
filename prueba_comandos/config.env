# Configuración de las pruebas de comandos (la lee prueba.sh).
# NO pongas aquí tu nombre: se guarda en config.local.env (no se sube a git).

# Dirección del servidor de ranking (la da el profesor). Sin barra final.
SERVIDOR_URL="http://192.168.2.1:8080"

# Clave compartida para que el servidor acepte envíos. Debe coincidir con CLAVE en ranking/docker-compose.yml
CLAVE="som-2026"

# Poner "no" para practicar sin enviar nada al ranking.
ENVIAR="si" 
